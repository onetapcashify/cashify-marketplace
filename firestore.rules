rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function isAdmin(){ return signedIn() && request.auth.token.email == 'onetapcashify@gmail.com'; }

    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /brands/{id} { allow read: if true; allow write: if isAdmin(); }
    match /services/{id} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /stores/{id} { allow read: if true; allow write: if isAdmin(); }
    match /hot_deals/{id} { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{id} { allow read: if true; allow write: if isAdmin(); }
    match /articles/{id} { allow read: if true; allow write: if isAdmin(); }
    match /news/{id} { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{id} { allow read: if true; allow write: if isAdmin(); }
    match /website_settings/{id} { allow read: if true; allow write: if isAdmin(); }

    match /coupons/{couponId} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn() && couponId == 'SEQ88' && request.resource.data.code == 'SEQ88' && request.resource.data.discountType == 'percentage' && request.resource.data.discountValue == 88 && request.resource.data.status == 'Active' && request.resource.data.claimLimit == 10 && request.resource.data.perUserLimit == 1 && request.resource.data.usedCount == 1);
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount','updatedAt']) &&
        request.resource.data.usedCount == resource.data.usedCount + 1 &&
        (resource.data.claimLimit == 0 || request.resource.data.usedCount <= resource.data.claimLimit)
      );
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /coupon_claims/{claimId} {
      allow read: if isAdmin();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }
  }
}
