rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'onetapcashify@gmail.com';
    }

    function isPublicModule(module) {
      return module in [
        'products',
        'categories',
        'brands',
        'services',
        'banners',
        'stores',
        'hot-deals',
        'testimonials',
        'articles',
        'news',
        'faqs',
        'coupons',
        'website-settings'
      ];
    }

    match /adminModules/{module}/rows/{rowId} {

      /* Public storefront content/settings/coupons. */
      allow read:
        if isPublicModule(module)
        || isAdmin()
        || (
          signedIn()
          && module in ['orders','payments']
          && resource.data.userId == request.auth.uid
        );

      /* Only admin creates CMS/settings/coupons. */
      allow create:
        if isAdmin()
        || (
          signedIn()
          && module in ['orders','payments']
          && request.resource.data.userId == request.auth.uid
        );

      /*
        Admin can update everything.
        A signed-in customer may only increment coupon usedCount by 1
        as part of the coupon claim transaction; coupon definition
        fields must remain unchanged.
      */
      allow update:
        if isAdmin()
        || (
          signedIn()
          && module == 'coupons'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['usedCount','updatedAt'])
          && request.resource.data.usedCount
              == resource.data.usedCount + 1
        );

      allow delete:
        if isAdmin();
    }

    match /couponClaims/{couponCode}/users/{userKey} {

      allow read:
        if isAdmin()
        || (
          signedIn()
          && resource.data.userKey == request.auth.uid
        );

      allow create:
        if signedIn()
        && request.resource.data.userKey == request.auth.uid
        && request.resource.data.count == 1;

      allow update:
        if signedIn()
        && resource.data.userKey == request.auth.uid
        && request.resource.data.userKey == request.auth.uid
        && request.resource.data.count == resource.data.count + 1;

      allow delete:
        if isAdmin();
    }
  }
}
